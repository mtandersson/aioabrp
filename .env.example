# Credentials for scripts/test_cli.py (the manual live-API smoke test).
# Copy to `.env` (gitignored) and fill in your own values.
#
# The API key is the Iternio *partner* key, not a per-user credential —
# see the project README "Get your own API key". The access token is your
# per-user ABRP token.

ABRP_API_KEY=your-iternio-partner-api-key
ABRP_ACCESS_TOKEN=your-abrp-access-token
